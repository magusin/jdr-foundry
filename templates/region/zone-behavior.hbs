{{!-- Template pour la fiche de configuration d'un piège / d'une zone à effet --}}
<div style="display:flex;flex-direction:column;gap:12px;padding:4px">

  <div class="form-group">
    <label style="font-weight:700">Nom (note MJ, visible dans le message de déclenchement)</label>
    <input type="text" name="system.label" value="{{system.label}}" placeholder="Ex: Fosse à pieux, Mur de ronces..." style="width:100%" />
  </div>

  <div class="form-group">
    <label style="font-weight:700">Caché aux joueurs</label>
    <input type="checkbox" name="system.hidden" {{#if system.hidden}}checked{{/if}} />
    <span style="font-size:11px;opacity:.7">Piège : la région n'est visible que du MJ tant qu'elle n'a pas été détectée ou déclenchée. Décoche pour une zone de sort visible (mur de glace, nuage...).</span>
  </div>

  <div class="form-group">
    <label style="font-weight:700">Se déclenche une seule fois par cible</label>
    <input type="checkbox" name="system.onceOnly" {{#if system.onceOnly}}checked{{/if}} />
    <span style="font-size:11px;opacity:.7">Décoche pour une zone persistante qui inflige son effet à chaque entrée (nuage toxique, sol brûlant...).</span>
  </div>

  <div class="form-group">
    <label style="font-weight:700">DD de détection (jet de Perception)</label>
    <input type="number" name="system.detectDC" value="{{system.detectDC}}" min="1" max="25" style="width:100%" />
  </div>

  <hr style="opacity:.2" />

  <div class="form-group">
    <label style="font-weight:700">Ralentissement à la traversée</label>
    <div style="display:flex;align-items:center;gap:8px">
      <input type="range" name="system.speedMult" value="{{system.speedMult}}"
        min="0.1" max="1" step="0.05" style="flex:1"
        oninput="this.nextElementSibling.textContent = '×' + parseFloat(this.value).toFixed(2)"/>
      <span style="min-width:60px;font-weight:600">×{{system.speedMult}}</span>
    </div>
    <span style="font-size:11px;opacity:.7">1 = aucun ralentissement, 0.1 = quasi infranchissable en un tour (pas de vrai blocage — juste un coût de déplacement énorme).</span>
  </div>

  <hr style="opacity:.2" />

  <div class="form-group">
    <label style="font-weight:700">Dégâts directs à l'entrée</label>
    <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="Ex: 2d6 (laisser vide = pas de dégâts)" style="width:100%" />
  </div>
  <div class="form-group">
    <label style="font-weight:700">Type de dégâts</label>
    <select name="system.damageLivraison" style="width:100%">
      <option value="physique" {{#if (eq system.damageLivraison "physique")}}selected{{/if}}>Physique</option>
      <option value="magique" {{#if (eq system.damageLivraison "magique")}}selected{{/if}}>Magique</option>
    </select>
  </div>

  <hr style="opacity:.2" />

  <div class="form-group">
    <label style="font-weight:700">État appliqué à l'entrée (optionnel)</label>
    <input type="text" name="system.effectLabel" value="{{system.effectLabel}}" placeholder="Ex: Empoisonné, Entravé... (laisser vide = pas d'état)" style="width:100%" />
  </div>
  <div class="form-group">
    <label style="font-weight:700">Durée de l'état (tours)</label>
    <input type="number" name="system.effectDuration" value="{{system.effectDuration}}" min="1" max="20" style="width:100%" />
  </div>
  <div class="form-group">
    <label style="font-weight:700">Dégâts par tour (optionnel)</label>
    <input type="number" name="system.effectDotPerTick" value="{{system.effectDotPerTick}}" min="0" style="width:100%" />
  </div>
  <div class="form-group">
    <label style="font-weight:700">Malus/bonus de vitesse (m, optionnel)</label>
    <input type="number" name="system.effectVitesseFlat" value="{{system.effectVitesseFlat}}" style="width:100%" placeholder="Ex: -3" />
  </div>

  <div class="form-group">
    <label style="font-weight:700">Actif</label>
    <input type="checkbox" name="system.enabled" {{#if system.enabled}}checked{{/if}} />
  </div>
</div>
