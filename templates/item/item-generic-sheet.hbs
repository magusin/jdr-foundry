{{!-- systems/rpg/templates/item/item-generic-sheet.hbs --}}
<div class="rpg-sheet generic-sheet" autocomplete="off">

  <header class="sheet-header" style="display:flex; gap:12px; align-items:center;">
    <img class="item-img rpg-img-edit" src="{{item.img}}" data-field="img" title="Changer l'image" style="width:128px;height:128px;object-fit:cover;border-radius:10px;" />
    <div style="flex:1;">
      {{#if isReadOnly}}
        <div style="width:100%; font-size:20px;"><b>{{item.name}}</b></div>
      {{else}}
        <input name="name" type="text" value="{{item.name}}" style="width:100%; font-size:20px;" />
      {{/if}}
      <small>{{typeLabel}}</small>
    </div>
    {{#if isGM}}
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
      <button type="button" data-action="sendToActors" style="cursor:pointer;padding:4px 10px;white-space:nowrap" title="Envoyer une copie à un ou plusieurs PJ">📤 Envoyer</button>
      <label style="display:flex;align-items:center;gap:4px;font-size:11px;white-space:nowrap;cursor:pointer"
        title="Synchronisé PAR DÉFAUT avec tout autre exemplaire du même nom déjà donné à un PJ, sans rien à faire : toute modification des champs de définition (poids, prix, effet...) se répercute automatiquement. La quantité et le reste de l'état propre à chaque copie restent indépendants. Décoche si CET exemplaire doit cesser de suivre les autres (ex. devenu un objet unique).">
        <input type="checkbox" data-action="toggleLinkSync" {{#unless (eq item.flags.rpg.linkSync false)}}checked{{/unless}} />
        🔗 Synchro
      </label>
    </div>
    {{/if}}
  </header>

  <div class="sheet-body">
    <hr/>

    <section>
      <h2>Détails</h2>

      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
        <div>
          <label>Quantité</label>
          {{#if canEdit}}
            <input type="number" name="system.qte" value="{{system.qte}}" min="0"/>
          {{else}}
            <div><b>{{system.qte}}</b></div>
          {{/if}}
        </div>
        <div>
          <label>Poids (unité)</label>
          {{#if canEdit}}
            <input type="number" name="system.poids" value="{{system.poids}}" min="0" step="0.1"/>
          {{else}}
            <div><b>{{system.poids}}</b></div>
          {{/if}}
        </div>
      </div>

      {{#if (eq item.type "consumable")}}
      <hr/>
      {{!-- Pas de compteur « utilisations » : un consommable se compte en
            QUANTITÉ, comme un objet. Consommer un exemplaire, c'est retirer 1
            à la pile — un second compteur par exemplaire empêchait l'empilement
            et faisait dix lignes d'inventaire pour dix rations identiques. --}}
      <div style="display:grid; grid-template-columns: 1fr; gap:10px;">
        <div>
          <label>Effet (texte libre, ce que ça fait à l'usage)</label>
          {{#if canEdit}}
            <textarea name="system.effet" rows="3">{{system.effet}}</textarea>
          {{else}}
            <div style="white-space:pre-wrap;">{{system.effet}}</div>
          {{/if}}
        </div>
      </div>
      {{/if}}

      {{#if isGM}}
        <hr/>
        <h3>Prix (MJ uniquement)</h3>
        <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:10px;">
          <div>
            <label>Cuivre</label>
            <input type="number" name="system.prix.cuivre" value="{{system.prix.cuivre}}" min="0"/>
          </div>
          <div>
            <label>Argent</label>
            <input type="number" name="system.prix.argent" value="{{system.prix.argent}}" min="0"/>
          </div>
          <div>
            <label>Or</label>
            <input type="number" name="system.prix.or" value="{{system.prix.or}}" min="0"/>
          </div>
        </div>
        <small style="opacity:0.8;">100 cuivre = 1 argent • 100 argent = 1 or</small>

        <div style="margin-top:8px;">
          <label>Vendeur associé (qui vend/lâche cet objet — filtre le Marché)</label>
          <input type="text" name="system.vendeurAssocie" value="{{system.vendeurAssocie}}" placeholder="Nom du marchand ou du monstre"/>
        </div>
      {{/if}}
    </section>

    <hr/>

    <section>
      <h2>Description</h2>
      {{#if canEdit}}
        <textarea name="system.description" rows="5">{{system.description}}</textarea>
      {{else}}
        {{#if system.description}}
          <div style="white-space:pre-wrap;"><b>{{system.description}}</b></div>
        {{else}}
          <small style="opacity:.8;">—</small>
        {{/if}}
      {{/if}}
    </section>
  </div>
</div>