<form class="rpg-sheet rpg-quest-sheet">
  <header class="sheet-header">
    <img class="profile-img rpg-img-edit" src="{{item.img}}" data-field="img" title="Changer l'image" />
    <div class="header-fields">
      <input name="name" type="text" value="{{item.name}}" placeholder="Nom de la quête" {{#unless canEdit}}disabled{{/unless}} />
    </div>
    {{#if isGM}}
    <button type="button" class="quest-send-btn" data-action="sendToActors" title="Envoyer une copie à un ou plusieurs PJ">📤 Envoyer</button>
    {{/if}}
  </header>

  <section class="sheet-body">

    <div class="form-group">
      <label>Statut global</label>
      <select name="system.statut" {{#unless canEdit}}disabled{{/unless}}>
        <option value="active" {{#if (eq system.statut "active")}}selected{{/if}}>En cours</option>
        <option value="reussie" {{#if (eq system.statut "reussie")}}selected{{/if}}>Réussie</option>
        <option value="echouee" {{#if (eq system.statut "echouee")}}selected{{/if}}>Échouée</option>
      </select>
    </div>

    <div class="form-group">
      <label>
        <input type="checkbox" name="system.partagee" {{#if system.partagee}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}} />
        Quête partagée (plusieurs PJ peuvent l'avoir, la progression reste synchronisée pour tous)
      </label>
    </div>

    {{#if isGM}}
    <div class="form-group">
      <label>Classe / Joueur requis (note pour toi, n'apparaît jamais au joueur)</label>
      <input type="text" name="system.classeRequise" value="{{system.classeRequise}}"
        placeholder="ex: Mage uniquement, ou nom du joueur" {{#unless canEdit}}disabled{{/unless}} />
    </div>
    {{/if}}

    <div class="form-group quest-progress">
      <label>Étape actuelle (le joueur ne voit que celle-ci + les étapes terminées en titre seul)</label>
      <div class="quest-progress-value">
        Étape {{calc.etapeActuelleNum}} / {{calc.totalEtapes}}
      </div>
    </div>

    <h3>Déroulé de la quête (étapes)</h3>
    <div class="quest-etapes">
      {{#each system.etapes as |etape ei|}}
      {{#if etape.termine}}
      {{!-- Vue joueur, étape déjà passée : titre seul, rien d'autre --}}
      <div class="etape-card etape-card-done">
        <span class="etape-heading">Étape {{etape.etapeNum}} — {{etape.label}}
          <span class="etape-heading-tag">— terminée</span></span>
      </div>
      {{else}}
      <div class="etape-card {{#if (eq ei ../system.etapeActuelle)}}etape-card-current{{/if}}" data-etape-idx="{{ei}}">

        <div class="etape-card-header">
          <span class="etape-heading">
            Étape {{etape.etapeNum}}
            {{#if (eq ei ../system.etapeActuelle)}}<span class="etape-heading-tag etape-heading-tag-current">— EN COURS</span>{{/if}}
            {{#if (lt ei ../system.etapeActuelle)}}<span class="etape-heading-tag">— terminée</span>{{/if}}
            {{#if (gt ei ../system.etapeActuelle)}}<span class="etape-heading-tag">— à venir (caché du joueur)</span>{{/if}}
          </span>
          {{#if canEdit}}
          <button type="button" class="etape-remove-btn" data-action="removeEtape" data-etape-idx="{{ei}}" title="Retirer l'étape">✕</button>
          {{/if}}
        </div>

        <input type="text" class="etape-title-input" name="system.etapes.{{ei}}.label" value="{{etape.label}}"
          placeholder="Titre de l'étape (ex: Trouver l'auberge)"
          {{#unless ../canEdit}}disabled{{/unless}} />

        <div class="etape-block">
          <label class="etape-block-label">Récit de l'étape (visible du joueur pendant qu'elle est en cours)</label>
          <textarea class="etape-description" name="system.etapes.{{ei}}.description" rows="3"
            placeholder="Ex: Tu arrives à l'auberge du Cerf. Le tenancier semble nerveux et évite ton regard..."
            {{#unless ../canEdit}}disabled{{/unless}}>{{etape.description}}</textarea>
        </div>

        <div class="etape-block">
          <label class="etape-block-label">Objectifs à cocher (visibles du joueur)</label>
          <div class="etape-objectifs">
            {{#each etape.objectifs as |obj oi|}}
            <div class="etape-objectif-row">
              <input type="checkbox" name="system.etapes.{{ei}}.objectifs.{{oi}}.fait" {{#if obj.fait}}checked{{/if}}
                {{#unless ../../canEdit}}disabled{{/unless}} />
              <input type="text" name="system.etapes.{{ei}}.objectifs.{{oi}}.text" value="{{obj.text}}"
                placeholder="Description de l'objectif" {{#unless ../../canEdit}}disabled{{/unless}} />
              {{#if ../../canEdit}}
              <button type="button" class="etape-remove-btn" data-action="removeObjectif" data-etape-idx="{{ei}}" data-obj-idx="{{oi}}" title="Retirer">✕</button>
              {{/if}}
            </div>
            {{/each}}
          </div>
          {{#if canEdit}}
          <button type="button" class="etape-add-objectif-btn" data-action="addObjectif" data-etape-idx="{{ei}}">+ Objectif</button>
          {{/if}}
        </div>

        {{#if canEdit}}
        <div class="etape-block">
          <label class="etape-block-label etape-block-label-mj">📝 Notes MJ pour cette étape (PNJ, lieux, récompense de mise en
            scène... — jamais visible du joueur)</label>
          <textarea class="etape-notes-mj" name="system.etapes.{{ei}}.notesMJ" rows="3"
            placeholder="Ex: PNJ Maître Aldric à l'auberge du Cerf ; lieu : quartier des artisans...">{{etape.notesMJ}}</textarea>
        </div>
        {{/if}}
      </div>
      {{/if}}
      {{/each}}
    </div>

    {{#if canEdit}}
    <div class="quest-etapes-nav">
      <button type="button" data-action="addEtape">+ Ajouter une étape</button>
      <button type="button" data-action="prevEtape">◀ Étape précédente</button>
      <button type="button" data-action="nextEtape">Étape suivante ▶</button>
    </div>
    {{/if}}

    {{#if isGM}}
    <h3 class="quest-section-title">Récompense (à la fin de la quête — jamais visible du joueur)</h3>
    <div class="form-group">
      <label>XP</label>
      <input type="number" name="system.recompense.xp" value="{{system.recompense.xp}}" min="0" {{#unless canEdit}}disabled{{/unless}} />
    </div>

    <div class="quest-reward-items">
      {{#each system.recompense.items as |ri idx|}}
      <div class="reward-row" data-idx="{{idx}}">
        <input type="text" name="system.recompense.items.{{idx}}.uuid" value="{{ri.uuid}}"
          placeholder="UUID de l'objet (clic droit -> Copy UUID)" class="reward-uuid" {{#unless canEdit}}disabled{{/unless}} />
        <input type="text" name="system.recompense.items.{{idx}}.name" value="{{ri.name}}"
          placeholder="Nom affiché" class="reward-name" {{#unless canEdit}}disabled{{/unless}} />
        <input type="number" name="system.recompense.items.{{idx}}.qty" value="{{ri.qty}}" min="1" class="reward-qty" {{#unless canEdit}}disabled{{/unless}} />
        {{#if canEdit}}
        <button type="button" class="etape-remove-btn" data-action="removeRewardItem" data-idx="{{idx}}" title="Retirer">✕</button>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{#if canEdit}}
    <button type="button" class="quest-add-reward-btn" data-action="addRewardItem">+ Ajouter un objet en récompense</button>
    {{/if}}
    {{/if}}

    <h3 class="quest-section-title">Description</h3>
    <textarea name="system.description" rows="5" {{#unless canEdit}}disabled{{/unless}}>{{system.description}}</textarea>

  </section>
</form>
