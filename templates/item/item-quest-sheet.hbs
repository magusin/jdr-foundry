<form class="rpg-sheet rpg-quest-sheet">
  <header class="sheet-header">
    <img class="profile-img rpg-img-edit" src="{{item.img}}" data-field="img" title="Changer l'image" />
    <div class="header-fields">
      <input name="name" type="text" value="{{item.name}}" placeholder="Nom de la quête" {{#unless canEdit}}disabled{{/unless}} />
    </div>
    {{#if isGM}}
    <button type="button" class="quest-send-btn" data-action="sendToActors" title="Envoyer une copie à un ou plusieurs PJ">📤 Envoyer</button>
    {{/if}}
  </header>

  <section class="sheet-body quest-layout">

    {{!-- ── Liste des pages, façon journal : une page par étape + les pages
    fixes (Aperçu, Récompense, Description). Cliquer une entrée montre son
    contenu à droite sans recharger toute la fiche. ── --}}
    <nav class="quest-page-nav tabs" data-group="pages">
      <a class="item quest-page-item" data-tab="apercu">📋 <span>Aperçu</span></a>
      {{#each system.etapes as |etape ei|}}
      <a class="item quest-page-item
        {{#if (lt ei ../system.etapeActuelle)}}quest-page-done{{/if}}
        {{#if (eq ei ../system.etapeActuelle)}}quest-page-current{{/if}}"
        data-tab="etape-{{ei}}">
        {{#if (lt ei ../system.etapeActuelle)}}✓{{else if (eq ei ../system.etapeActuelle)}}▶{{else}}⏳{{/if}}
        <span>{{etape.etapeNum}}. {{etape.navLabel}}</span>
      </a>
      {{/each}}
      {{#if isGM}}
      <a class="item quest-page-item" data-tab="recompense">🎁 <span>Récompense</span></a>
      {{/if}}
      <a class="item quest-page-item" data-tab="description">📖 <span>Description</span></a>
    </nav>

    <div class="quest-page-content">

      {{!-- ── PAGE : Aperçu ── --}}
      <div class="tab" data-group="pages" data-tab="apercu">
        <div class="form-group">
          <label>Statut global</label>
          <select name="system.statut" {{#unless canEdit}}disabled{{/unless}}>
            <option value="active" {{#if (eq system.statut "active")}}selected{{/if}}>En cours</option>
            <option value="reussie" {{#if (eq system.statut "reussie")}}selected{{/if}}>Réussie</option>
            <option value="echouee" {{#if (eq system.statut "echouee")}}selected{{/if}}>Échouée</option>
          </select>
        </div>

        <div class="form-group">
          <label class="quest-checkbox-label" title="Plusieurs PJ peuvent l'avoir ; la progression reste synchronisée pour tous.">
            <input type="checkbox" name="system.partagee" {{#if system.partagee}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}} />
            Quête partagée
          </label>
        </div>

        {{#if isGM}}
        <div class="form-group quest-recipients">
          <label title="Un PJ ne voit la quête que s'il en a sa propre copie — coche/décoche pour la lui donner ou la lui retirer.">Qui voit cette quête ?</label>
          {{#if recipients.length}}
          <div class="quest-recipients-list">
            {{#each recipients as |r|}}
            <label class="quest-checkbox-label">
              <input type="checkbox" class="quest-recipient-check" data-actor-id="{{r.id}}" {{#if r.hasCopy}}checked{{/if}} />
              {{r.name}}
            </label>
            {{/each}}
          </div>
          {{else}}
          <p class="quest-hint">Aucun personnage joueur dans le monde.</p>
          {{/if}}
        </div>

        <div class="form-group">
          <label title="Note pour toi, n'apparaît jamais au joueur.">Classe / Joueur requis</label>
          <input type="text" name="system.classeRequise" value="{{system.classeRequise}}"
            placeholder="ex: Mage uniquement, ou nom du joueur" {{#unless canEdit}}disabled{{/unless}} />
        </div>
        {{/if}}

        <div class="form-group quest-progress">
          <label title="Le joueur ne voit que celle-ci + les étapes terminées en titre seul.">Étape actuelle</label>
          <div class="quest-progress-value">
            {{#if calc.complete}}✅ Toutes les étapes terminées{{else}}Étape {{calc.etapeActuelleNum}} / {{calc.totalEtapes}}{{/if}}
          </div>
        </div>

        {{#if canEdit}}
        <div class="quest-etapes-nav">
          <button type="button" data-action="addEtape">+ Ajouter une étape</button>
          <button type="button" data-action="prevEtape">◀ Étape précédente</button>
          <button type="button" data-action="nextEtape">Étape suivante ▶</button>
        </div>
        {{/if}}
      </div>

      {{!-- ── PAGE : une par étape ── --}}
      {{#each system.etapes as |etape ei|}}
      <div class="tab" data-group="pages" data-tab="etape-{{ei}}">
        {{#if etape.termine}}
        {{!-- Vue joueur, étape déjà passée : titre seul, rien d'autre --}}
        <div class="etape-card etape-card-done">
          <span class="etape-heading">Étape {{etape.etapeNum}} — {{etape.label}}
            <span class="etape-heading-tag">— terminée</span></span>
        </div>
        {{else}}
        <div class="etape-card {{#if (eq ei ../system.etapeActuelle)}}etape-card-current{{/if}}" data-etape-idx="{{ei}}">

          <div class="etape-card-header">
            <span class="etape-heading">
              Étape {{etape.etapeNum}}
              {{#if (eq ei ../system.etapeActuelle)}}<span class="etape-heading-tag etape-heading-tag-current">— EN COURS</span>{{/if}}
              {{#if (lt ei ../system.etapeActuelle)}}<span class="etape-heading-tag">— terminée</span>{{/if}}
              {{#if (gt ei ../system.etapeActuelle)}}<span class="etape-heading-tag" title="Caché du joueur">— à venir</span>{{/if}}
            </span>
            {{#if ../canEdit}}
            <button type="button" class="etape-remove-btn" data-action="removeEtape" data-etape-idx="{{ei}}" title="Retirer l'étape">✕</button>
            {{/if}}
          </div>

          <input type="text" class="etape-title-input" name="system.etapes.{{ei}}.label" value="{{etape.label}}"
            placeholder="Titre de l'étape (ex: Trouver l'auberge)"
            {{#unless ../canEdit}}disabled{{/unless}} />

          <div class="etape-block">
            <label class="etape-block-label" title="Visible du joueur pendant que cette étape est en cours. Glisse un PNJ, un objet ou une scène dans le texte pour créer un lien cliquable.">Récit de l'étape</label>
            {{#if ../canEdit}}
            <div class="rpg-pm-wrap">
              <prose-mirror name="system.etapes.{{ei}}.description"
                editable="true" toggled="false" class="rpg-quest-editor">{{{etape.descriptionHTML}}}</prose-mirror>
              <button type="button" class="rpg-pm-save-btn" data-action="savePmField" title="Enregistrer ce champ">💾 Enregistrer</button>
            </div>
            {{else}}
            <div class="rpg-enriched-text">{{{etape.descriptionHTML}}}</div>
            {{/if}}
          </div>

          <div class="etape-block">
            <label class="etape-block-label" title="Visibles du joueur.">Objectifs à cocher</label>
            <div class="etape-objectifs">
              {{#each etape.objectifs as |obj oi|}}
              <div class="etape-objectif-row">
                <input type="checkbox" name="system.etapes.{{ei}}.objectifs.{{oi}}.fait" {{#if obj.fait}}checked{{/if}}
                  {{#unless ../../canEdit}}disabled{{/unless}} />
                <input type="text" name="system.etapes.{{ei}}.objectifs.{{oi}}.text" value="{{obj.text}}"
                  placeholder="Description de l'objectif" {{#unless ../../canEdit}}disabled{{/unless}} />
                {{#if ../../canEdit}}
                <button type="button" class="etape-remove-btn" data-action="removeObjectif" data-etape-idx="{{ei}}" data-obj-idx="{{oi}}" title="Retirer">✕</button>
                {{/if}}
              </div>
              {{/each}}
            </div>
            {{#if ../canEdit}}
            <button type="button" class="etape-add-objectif-btn" data-action="addObjectif" data-etape-idx="{{ei}}">+ Objectif</button>
            {{/if}}
          </div>

          {{#if ../canEdit}}
          <div class="etape-block">
            <label class="etape-block-label etape-block-label-mj" title="PNJ, lieux, récompense de mise en scène... — jamais visible du joueur. Glisse un PNJ ou un objet dans le texte pour créer un lien cliquable.">📝 Notes MJ</label>
            <div class="rpg-pm-wrap">
              <prose-mirror name="system.etapes.{{ei}}.notesMJ"
                editable="true" toggled="false" class="rpg-quest-editor">{{{etape.notesMJHTML}}}</prose-mirror>
              <button type="button" class="rpg-pm-save-btn" data-action="savePmField" title="Enregistrer ce champ">💾 Enregistrer</button>
            </div>
          </div>
          {{/if}}
        </div>
        {{/if}}
      </div>
      {{/each}}

      {{!-- ── PAGE : Récompense (MJ uniquement) ── --}}
      {{#if isGM}}
      <div class="tab" data-group="pages" data-tab="recompense">
        <h3 class="quest-section-title" title="Distribuée à la fin de la quête — jamais visible du joueur.">Récompense</h3>
        <div class="form-group">
          <label>XP</label>
          <input type="number" name="system.recompense.xp" value="{{system.recompense.xp}}" min="0" {{#unless canEdit}}disabled{{/unless}} />
        </div>

        <div class="quest-reward-items">
          {{#each system.recompense.items as |ri idx|}}
          <div class="reward-row" data-idx="{{idx}}" style="display:flex;align-items:center;gap:6px;margin-bottom:6px;padding:4px;background:var(--surface);border-radius:6px">
            {{#if ri.uuid}}
            <img src="{{ri.img}}" alt="" style="width:28px;height:28px;border-radius:5px;object-fit:cover" />
            <span style="flex:1;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ri.name}}</span>
            <button type="button" class="rpg-open-uuid" data-uuid="{{ri.uuid}}" title="Ouvrir la fiche de l'objet"
              style="cursor:pointer;padding:1px 6px;font-size:10px">📄</button>
            <input type="hidden" name="system.recompense.items.{{idx}}.uuid" value="{{ri.uuid}}" />
            {{else}}
            <input type="text" name="system.recompense.items.{{idx}}.uuid" value="{{ri.uuid}}"
              placeholder="UUID de l'objet (clic droit -> Copy UUID), ou glisse-le directement" class="reward-uuid"
              style="flex:1;font-size:11px" {{#unless ../canEdit}}disabled{{/unless}} />
            {{/if}}
            <input type="number" name="system.recompense.items.{{idx}}.qty" value="{{ri.qty}}" min="1" class="reward-qty"
              style="width:48px;font-size:12px;text-align:center" {{#unless ../canEdit}}disabled{{/unless}} />
            {{#if ../canEdit}}
            <button type="button" class="etape-remove-btn" data-action="removeRewardItem" data-idx="{{idx}}" title="Retirer">✕</button>
            {{/if}}
          </div>
          {{/each}}
        </div>
        {{#if canEdit}}
        <div class="quest-reward-dropzone" title="Compendium, inventaire, barre d'items...">
          🎁 Glisse un objet ici pour l'ajouter en récompense
        </div>
        <button type="button" class="quest-add-reward-btn" data-action="addRewardItem">+ Ajouter un objet via UUID</button>
        {{/if}}
      </div>
      {{/if}}

      {{!-- ── PAGE : Description ── --}}
      <div class="tab" data-group="pages" data-tab="description">
        <h3 class="quest-section-title">Description</h3>
        {{#if canEdit}}
        <div class="rpg-pm-wrap">
          <prose-mirror name="system.description"
            editable="true" toggled="false" class="rpg-quest-editor">{{{descriptionHTML}}}</prose-mirror>
          <button type="button" class="rpg-pm-save-btn" data-action="savePmField" title="Enregistrer ce champ">💾 Enregistrer</button>
        </div>
        {{else}}
        <div class="rpg-enriched-text">{{{descriptionHTML}}}</div>
        {{/if}}
      </div>

    </div>
  </section>
</form>
