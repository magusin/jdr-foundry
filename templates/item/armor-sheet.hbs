{{!-- systems/rpg/templates/item/item-armor-sheet.hbs
     Sert aux ARMURES et aux RELIQUES (type relic) : même mécanique
     d'équipement et de bonus, seules changent l'étiquette et le choix
     d'emplacement (une relique n'en a qu'un). Voir item-armor-sheet-v2.js. --}}
<div class="rpg-sheet armor-sheet{{#if isRelic}} relic-sheet{{/if}}" autocomplete="off">

  {{!-- HEADER --}}
  <header class="sheet-header" style="display:flex; gap:12px; align-items:center;">
    <img
      class="item-profile rpg-img-edit"
      src="{{item.img}}"
      data-field="img"
      title="Changer l'image"
      style="width:128px;height:128px;object-fit:cover;border-radius:10px;flex:0 0 128px;max-width:none;"
    />

    <div style="flex:1;">
      {{#if isReadOnly}}
        <div style="width:100%; font-size:20px;"><b>{{item.name}}</b></div>
      {{else}}
        <input name="name" type="text" value="{{item.name}}" style="width:100%; font-size:20px;" />
      {{/if}}
      <small>{{#if isRelic}}Relique{{else}}Armure{{/if}}</small>
    </div>
    {{#if isGM}}
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
      <button type="button" data-action="sendToActors" style="cursor:pointer;padding:4px 10px;white-space:nowrap" title="Envoyer une copie à un ou plusieurs PJ">📤 Envoyer</button>
      <label style="display:flex;align-items:center;gap:4px;font-size:11px;white-space:nowrap;cursor:pointer"
        title="Synchronisé PAR DÉFAUT avec tout autre exemplaire du même nom déjà donné à un PJ, sans rien à faire : toute modification des champs de définition (bonus, poids, prix...) se répercute automatiquement. L'état propre à chaque copie (équipé, quantité...) reste indépendant. Décoche si CET exemplaire doit cesser de suivre les autres (ex. devenu un objet unique).">
        <input type="checkbox" data-action="toggleLinkSync" {{#unless (eq item.flags.rpg.linkSync false)}}checked{{/unless}} />
        🔗 Synchro
      </label>
    </div>
    {{/if}}
  </header>

  {{!-- BODY SCROLL --}}
  <div class="sheet-body">

    <hr/>

    {{!-- ÉQUIPEMENT --}}
    <section>
      <h2>Équipement</h2>
      <label>Emplacement</label>

      {{#if isRelic}}
        {{!-- Une relique n'a qu'un emplacement possible : pas de choix à
             offrir, et surtout aucun moyen de la ranger par erreur dans un
             emplacement d'armure où elle ne serait jamais visible. --}}
        <div style="margin-top:4px;">
          <b>✨ Relique</b>
          <div style="font-size:11px;opacity:.7;margin-top:2px">
            Emplacement unique, indépendant des pièces d'armure : une seule relique
            portée à la fois, ses bonus s'appliquent tant qu'elle est équipée.
          </div>
        </div>
      {{else if canEdit}}
        <select name="system.emplacement" style="width:100%;">
          <option value="">— Choisir —</option>
          <option value="tete"   {{#if (eq system.emplacement "tete")}}selected{{/if}}>Tête</option>
          <option value="torse"  {{#if (eq system.emplacement "torse")}}selected{{/if}}>Torse</option>
          <option value="taille" {{#if (eq system.emplacement "taille")}}selected{{/if}}>Taille</option>
          <option value="bras"   {{#if (eq system.emplacement "bras")}}selected{{/if}}>Bras</option>
          <option value="mains"  {{#if (eq system.emplacement "mains")}}selected{{/if}}>Mains</option>
          <option value="jambes" {{#if (eq system.emplacement "jambes")}}selected{{/if}}>Jambes</option>
          <option value="pieds"  {{#if (eq system.emplacement "pieds")}}selected{{/if}}>Pieds</option>
        </select>
      {{else}}
        <div style="margin-top:4px;">
          <b>
            {{#if (eq system.emplacement "tete")}}Tête{{/if}}
            {{#if (eq system.emplacement "torse")}}Torse{{/if}}
            {{#if (eq system.emplacement "taille")}}Taille{{/if}}
            {{#if (eq system.emplacement "bras")}}Bras{{/if}}
            {{#if (eq system.emplacement "mains")}}Mains{{/if}}
            {{#if (eq system.emplacement "jambes")}}Jambes{{/if}}
            {{#if (eq system.emplacement "pieds")}}Pieds{{/if}}
            {{#unless system.emplacement}}—{{/unless}}
          </b>
        </div>
      {{/if}}
    </section>

    <hr/>

    {{!-- BONUS --}}
    <section>
      <h2>Bonus (si équipé)</h2>

      {{#if canEdit}}
        <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:10px;">
          <div><label>Force</label><input type="number" name="system.bonus.force" value="{{system.bonus.force}}"/></div>
          <div><label>Intelligence</label><input type="number" name="system.bonus.intelligence" value="{{system.bonus.intelligence}}"/></div>
          <div><label>Dextérité</label><input type="number" name="system.bonus.dexterite" value="{{system.bonus.dexterite}}"/></div>
          <div><label>Acuité</label><input type="number" name="system.bonus.acuite" value="{{system.bonus.acuite}}"/></div>
          <div><label>Endurance</label><input type="number" name="system.bonus.endurance" value="{{system.bonus.endurance}}"/></div>

          <div><label>Armure fixe</label><input type="number" name="system.bonus.armureFixe" value="{{system.bonus.armureFixe}}"/></div>
          <div><label>Résistance fixe</label><input type="number" name="system.bonus.resistanceFixe" value="{{system.bonus.resistanceFixe}}"/></div>
          <div><label>Score Armure</label><input type="number" name="system.bonus.scoreArmure" value="{{system.bonus.scoreArmure}}"/></div>
          <div><label>Score Résistance</label><input type="number" name="system.bonus.scoreResistance" value="{{system.bonus.scoreResistance}}"/></div>
          <div><label title="Modifie le TN des jets de retrait d'état pour le porteur (négatif = plus facile à se défaire des états)">Mod. Retrait État <span style="opacity:.5;font-size:10px">(+/- TN)</span></label><input type="number" name="system.bonus.retraitMod" value="{{system.bonus.retraitMod}}" placeholder="0"/></div>

          <div><label>PV max</label><input type="number" name="system.bonus.pvMax" value="{{system.bonus.pvMax}}"/></div>
          <div><label>Mana max</label><input type="number" name="system.bonus.manaMax" value="{{system.bonus.manaMax}}"/></div>
          <div><label>Fatigue max</label><input type="number" name="system.bonus.fatigueMax" value="{{system.bonus.fatigueMax}}"/></div>
          <div><label title="Pourcentage ajouté à la régénération de base (1 PV/tour). Le calcul arrondit à l'entier inférieur : en dessous de +100 %, le bonus ne rend rien.">Régén PV %</label><input type="number" name="system.bonus.regenPvPct" value="{{system.bonus.regenPvPct}}"/></div>
          <div><label title="Pourcentage ajouté à la régénération de mana de base. Même arrondi que la régén PV.">Régén Mana %</label><input type="number" name="system.bonus.regenManaPct" value="{{system.bonus.regenManaPct}}"/></div>

          <div><label>Vitesse</label><input type="number" name="system.bonus.vitesse" value="{{system.bonus.vitesse}}"/></div>
          <div><label>Pods max</label><input type="number" name="system.bonus.podsMax" value="{{system.bonus.podsMax}}"/></div>

          <div><label>Toucher physique</label><input type="number" name="system.bonus.toucherPhysique" value="{{system.bonus.toucherPhysique}}"/></div>
          <div><label>Toucher magique</label><input type="number" name="system.bonus.toucherMagique" value="{{system.bonus.toucherMagique}}"/></div>
        </div>
      {{else}}
        {{#if displayBonuses.length}}
          <ul style="margin:0; padding-left:18px;">
            {{#each displayBonuses as |b|}}
              <li><b>{{b.label}}</b> : {{#if (gt b.value 0)}}+{{/if}}{{b.value}}</li>
            {{/each}}
          </ul>
        {{else}}
          <small style="opacity:.8;">Aucun bonus.</small>
        {{/if}}
      {{/if}}

      <div style="margin-top:10px;">
        <label>Poids</label>
        {{#if canEdit}}
          <input type="number" name="system.poids" value="{{system.poids}}" min="0" step="0.1" />
        {{else}}
          <div><b>{{system.poids}}</b></div>
        {{/if}}
      </div>
    </section>

    {{!-- PRIX (MJ ONLY) --}}
    {{#if isGM}}
      <hr/>
      <section>
        <h2>Prix (MJ)</h2>
        <div class="resource-grid" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px;">
          <div><label>Cuivre</label><input type="number" name="system.prix.cuivre" value="{{system.prix.cuivre}}" min="0"/></div>
          <div><label>Argent</label><input type="number" name="system.prix.argent" value="{{system.prix.argent}}" min="0"/></div>
          <div><label>Or</label><input type="number" name="system.prix.or" value="{{system.prix.or}}" min="0"/></div>
        </div>
        <small style="opacity:0.8;">100 cuivre = 1 argent • 100 argent = 1 or</small>
      </section>
    {{/if}}

    {{!-- PESÉE / THÉORIECRAFT (MJ ONLY)
          `itemValue` n'est calculé que pour un MJ (voir le contrôleur) : pour
          un joueur il vaut null, donc ce bloc n'existe pas et aucun chiffre
          n'atteint son navigateur. --}}
    {{#if itemValue}}
      <hr/>
      <section class="rpg-item-value">
        <h2>⚖️ Pesée (MJ)</h2>
        <div class="rpg-iv-head">
          <span class="rpg-iv-total">{{itemValue.total}}</span>
          <span class="rpg-iv-tier rpg-iv-{{itemValue.tier.key}}">{{itemValue.tier.label}}</span>
        </div>
        {{#if itemValue.rows.length}}
        <table class="rpg-iv-table">
          <thead><tr><th>Ligne</th><th>Valeur</th><th>Poids</th></tr></thead>
          <tbody>
            {{#each itemValue.rows}}
            <tr{{#if warn}} class="rpg-iv-warn"{{/if}}>
              <td>{{label}}</td><td>{{value}}</td><td>{{points}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{else}}
        <small style="opacity:.8;">Aucun bonus — objet purement narratif.</small>
        {{/if}}
        {{#each itemValue.warnings}}
        <div class="rpg-iv-alert">⚠️ {{this}}</div>
        {{/each}}
        <small class="rpg-iv-help">
          Repère : une pièce de départ pèse 0–5, une pièce de milieu de partie 15–30.
          Le poids estime l'impact réel d'une ligne, pas sa valeur brute — 1 d'armure fixe
          vaut ~36 de score d'armure, parce qu'elle est retirée de chaque coup reçu.
          Amplifications non comptées.
        </small>
      </section>
    {{/if}}

    {{#if canEdit}}
      <section>
        <h2>Recette associée</h2>
        {{#if canEdit}}
        <div class="resource-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
          <div><label>UUID</label><input type="text" name="system.recetteAssociee.uuid" value="{{system.recetteAssociee.uuid}}"
            placeholder="Compendium...Item.xxxx"/></div>
          <div><label>Nom (info)</label><input type="text" name="system.recetteAssociee.name" value="{{system.recetteAssociee.name}}"/></div>
        </div>
        {{else}}
        {{#if system.recetteAssociee.uuid}}
        <div style="font-size:12px;opacity:.7">Recette : {{system.recetteAssociee.name}}</div>
        {{/if}}
        {{/if}}
        {{#if system.recetteAssociee.uuid}}
        <button type="button" class="rpg-open-uuid" data-uuid="{{system.recetteAssociee.uuid}}"
          style="margin-top:6px;cursor:pointer;padding:3px 10px;border-radius:5px;font-size:12px">
          📜 Voir la recette
        </button>
        {{/if}}

        <div style="margin-top:8px;">
          <label>Vendeur associé</label>
          <input type="text" name="system.vendeurAssocie" value="{{system.vendeurAssocie}}" placeholder="Nom du marchand ou du monstre" style="width:100%" {{#unless canEdit}}disabled{{/unless}}/>
        </div>
      </section>
    {{/if}}

    {{!-- RÉSISTANCES ÉLÉMENTAIRES --}}
    <hr/>
    <section>
      <h2>Résistances aux dégâts (par type)</h2>
      {{#if canEdit}}
        <div class="rpg-resist-elem-grid">
          {{#each resistElemRows as |r|}}
          <div class="rpg-resist-elem-cell">
            <label title="Réduction des dégâts de type {{r.label}} tant que l'objet est équipé. Négatif = vulnérabilité.">{{r.label}}</label>
            <div class="rpg-resist-elem-input">
              <input type="number" name="system.resistancesElem.{{r.key}}" value="{{r.value}}" min="-100" max="100" step="5"/>
              <span>%</span>
            </div>
          </div>
          {{/each}}
        </div>
        <div style="font-size:11px;color:var(--color-text-secondary);margin-top:4px">
          Réduit les <b>dégâts</b> reçus de ce type (arme, sort, piège) tant que l'objet est équipé.
          <b>100 %</b> = immunité, valeur <b>négative</b> = vulnérabilité (dégâts augmentés).
          Différent des « Résistances aux états » ci-dessous, qui n'agissent que sur la durée et les dégâts par tour des états.
        </div>
      {{else}}
        {{#if resistElemActive.length}}
        <div class="rpg-resist-elem-read">
          {{#each resistElemActive as |r|}}
          <span class="rpg-resist-elem-chip {{#if r.isWeak}}is-weak{{else}}is-resist{{/if}}">{{r.text}}</span>
          {{/each}}
        </div>
        {{else}}
        <div style="font-size:11px;opacity:.7">Aucune résistance aux dégâts.</div>
        {{/if}}
      {{/if}}
    </section>

    {{!-- RÉSISTANCES AUX ÉTATS — lecture pour le joueur, édition pour le MJ --}}
    {{#unless canEdit}}
      <hr/>
      <section>
        <h2>Résistances aux états (durée / dégâts par tour)</h2>
        {{#if resistStateRows.length}}
        <ul style="margin:0;padding-left:18px">
          {{#each resistStateRows as |r|}}<li style="font-size:12px">{{r.text}}</li>{{/each}}
        </ul>
        {{else}}
        <div style="font-size:11px;opacity:.7">Aucune résistance aux états.</div>
        {{/if}}
      </section>
    {{/unless}}
    {{#if canEdit}}
      <hr/>
      <section>
        <h2>Résistances aux états (durée / dégâts par tour)</h2>
        <div class="rpg-resistances">
          {{#each system.resistances as |r idx|}}
          <div class="resistance-row" data-idx="{{idx}}" style="display:flex;gap:6px;align-items:center;margin-bottom:4px">
            <select name="system.resistances.{{idx}}.tag" style="flex:1.5">
              {{#each ../EFFECT_TAGS as |label tag|}}
                <option value="{{tag}}" {{#if (eq r.tag tag)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <select name="system.resistances.{{idx}}.effectKey" style="flex:1.5;font-size:11px"
              title="Vide = tous les effets du type choisi ci-contre. Sinon, un effet précis du catalogue.">
              <option value="">— Tous les effets de ce type —</option>
              {{#each @root.EFFECT_CATALOG as |group gLabel|}}
              <optgroup label="{{gLabel}}">
                {{#each group as |e|}}
                <option value="{{e.value}}" {{#if (eq r.effectKey e.value)}}selected{{/if}}>{{e.label}}</option>
                {{/each}}
              </optgroup>
              {{/each}}
            </select>
            <label style="font-size:11px;white-space:nowrap">Durée -<input type="number" name="system.resistances.{{idx}}.durationReduction" value="{{r.durationReduction}}" min="0" style="width:50px"/></label>
            <label style="font-size:11px;white-space:nowrap">DOT -<input type="number" name="system.resistances.{{idx}}.dotReductionPct" value="{{r.dotReductionPct}}" min="0" max="100" style="width:50px"/>%</label>
            <label style="font-size:11px;white-space:nowrap"><input type="checkbox" name="system.resistances.{{idx}}.immune" {{#if r.immune}}checked{{/if}}/> Immunité</label>
            <button type="button" data-action="removeResistance" data-idx="{{idx}}" title="Retirer">✕</button>
          </div>
          {{/each}}
        </div>
        <button type="button" data-action="addResistance" style="margin-top:4px">+ Ajouter une résistance</button>
        <div style="font-size:11px;color:var(--color-text-secondary);margin-top:4px">
          Réduit la durée et/ou les dégâts par tour des effets portant le tag choisi (ex: Brûlure = Feu).
          Cochez Immunité pour bloquer totalement les effets de ce tag.
        </div>
      </section>
    {{/if}}
    {{!-- AMPLIFICATION DES EFFETS (MJ ONLY) --}}
    {{#if canEdit}}
      <section class="card">
        <h2>Amplification des effets</h2>
        <div class="rpg-amplifications">
          {{#each system.amplifications as |a idx|}}
          <div class="amplification-row" data-idx="{{idx}}" style="display:flex;gap:6px;align-items:center;margin-bottom:4px">
            <select name="system.amplifications.{{idx}}.tag" style="flex:1.5">
              {{#each ../EFFECT_TAGS as |label tag|}}
                <option value="{{tag}}" {{#if (eq a.tag tag)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <select name="system.amplifications.{{idx}}.effectKey" style="flex:1.5;font-size:11px"
              title="Vide = tous les effets du type choisi ci-contre. Sinon, un effet précis du catalogue.">
              <option value="">— Tous les effets de ce type —</option>
              {{#each @root.EFFECT_CATALOG as |group gLabel|}}
              <optgroup label="{{gLabel}}">
                {{#each group as |e|}}
                <option value="{{e.value}}" {{#if (eq a.effectKey e.value)}}selected{{/if}}>{{e.label}}</option>
                {{/each}}
              </optgroup>
              {{/each}}
            </select>
            <label style="font-size:11px;white-space:nowrap" title="Tours ajoutés à la durée de l'effet appliqué.">Durée +<input type="number" name="system.amplifications.{{idx}}.durationBonus" value="{{a.durationBonus}}" style="width:50px"/></label>
            <label style="font-size:11px;white-space:nowrap" title="Renforce les dégâts ou le soin par tour de l'effet.">Puissance +<input type="number" name="system.amplifications.{{idx}}.dotBonusPct" value="{{a.dotBonusPct}}" min="-100" max="500" style="width:50px"/>%</label>
            <label style="font-size:11px;white-space:nowrap" title="Renforce les bonus et malus de stats portés par l'effet.">Bonus/Malus +<input type="number" name="system.amplifications.{{idx}}.modBonusPct" value="{{a.modBonusPct}}" min="-100" max="500" style="width:50px"/>%</label>
            <button type="button" data-action="removeAmplification" data-idx="{{idx}}" title="Retirer">✕</button>
          </div>
          {{/each}}
        </div>
        <button type="button" data-action="addAmplification" style="margin-top:4px">+ Ajouter une amplification</button>
        <div style="font-size:11px;opacity:0.8;margin-top:4px">
          Renforce les effets que <b>le porteur applique</b> aux autres (durée, dégâts/soin par tour, bonus/malus).
          C'est le pendant offensif des résistances. Valeurs négatives = affaiblissement.
        </div>
      </section>
    {{/if}}

    <hr/>

    {{!-- DESCRIPTION --}}
    <section>
      <h2>Description</h2>
      <label>Description</label>

      {{#if canEdit}}
        <textarea name="system.description" rows="4">{{system.description}}</textarea>
      {{else}}
        {{#if system.description}}
          <div style="white-space:pre-wrap;"><b>{{system.description}}</b></div>
        {{else}}
          <small style="opacity:.8;">—</small>
        {{/if}}
      {{/if}}
    </section>

  </div>
</div>