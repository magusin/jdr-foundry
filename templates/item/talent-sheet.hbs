{{!-- Fiche TALENT — voir module/sheets/item-talent-sheet-v2.js et
      module/rules/loadout.js. Volontairement minimale : un talent ne fait
      que des mods de stats, donc tout autre champ serait un piège à
      remplir. --}}
<form class="rpg-sheet rpg-talent-sheet">
  <header class="sheet-header" style="display:flex;align-items:center;gap:10px">
    <img class="rpg-img-edit" src="{{item.img}}" data-field="img" title="Changer l'image"
      style="width:48px;height:48px;cursor:{{#if canEdit}}pointer{{else}}default{{/if}};border-radius:8px;border:1px solid var(--color-border-light-2)"/>
    <div class="header-fields" style="flex:1">
      {{#if canEdit}}
      <input name="name" type="text" value="{{item.name}}" placeholder="Nom du talent" />
      {{else}}
      <h2 style="margin:0">{{item.name}}</h2>
      {{/if}}
      <div style="font-size:11px;opacity:.7">🎭 Talent — un seul porté à la fois, gratuit, actif en permanence</div>
    </div>
    {{#if isGM}}
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
      <button type="button" data-action="sendToActors" style="cursor:pointer;padding:4px 10px;white-space:nowrap" title="Envoyer une copie à un ou plusieurs PJ — c'est ainsi qu'on débloque un talent">📤 Envoyer</button>
      <label style="display:flex;align-items:center;gap:4px;font-size:11px;white-space:nowrap;cursor:pointer"
        title="Synchronisé PAR DÉFAUT avec tout autre exemplaire du même nom déjà donné à un PJ : toute modification des bonus/malus se répercute. Décoche si CET exemplaire doit cesser de suivre les autres.">
        <input type="checkbox" data-action="toggleLinkSync" {{#unless (eq item.flags.rpg.linkSync false)}}checked{{/unless}} />
        🔗 Synchro
      </label>
    </div>
    {{/if}}
  </header>

  <section class="sheet-body" style="padding:10px;display:flex;flex-direction:column;gap:12px">

    {{#if summary}}
    <div class="card">
      <h2>Effet</h2>
      <div style="font-size:13px;line-height:1.7">{{summary}}</div>
    </div>
    {{/if}}

    <div class="card">
      <h2>Bonus &amp; malus</h2>
      <div class="talent-mod-list" style="display:flex;flex-direction:column;gap:6px">
        {{#each mods as |mod mi|}}
        <div class="talent-mod-row" data-mod-index="{{mi}}"
          style="display:grid;grid-template-columns:1fr auto auto 70px auto;gap:6px;align-items:center">
          <select data-mod-field="stat" {{#unless @root.canEdit}}disabled{{/unless}}>
            {{#each @root.statGroups as |grp|}}
            <optgroup label="{{grp.label}}">
              {{#each grp.options as |opt|}}
              <option value="{{opt.value}}" {{#if (eq mod.stat opt.value)}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </optgroup>
            {{/each}}
          </select>
          <select data-mod-field="sens" {{#unless @root.canEdit}}disabled{{/unless}}>
            <option value="bonus" {{#unless mod.isMalus}}selected{{/unless}}>⬆️ Bonus</option>
            <option value="malus" {{#if mod.isMalus}}selected{{/if}}>⬇️ Malus</option>
          </select>
          <select data-mod-field="mode" {{#unless @root.canEdit}}disabled{{/unless}}>
            <option value="flat" {{#if (eq mod.mode "flat")}}selected{{/if}}>Fixe</option>
            <option value="pct"  {{#if (eq mod.mode "pct")}}selected{{/if}}>%</option>
          </select>
          <input type="number" data-mod-field="value" value="{{mod.absValue}}" min="0" placeholder="0"
            title="Quantité, toujours positive — le sens est choisi à gauche."
            {{#unless @root.canEdit}}disabled{{/unless}}/>
          {{#if @root.canEdit}}
          <button type="button" data-action="removeMod" data-mod-index="{{mi}}"
            class="fx-del-btn" title="Retirer cette ligne">✕</button>
          {{else}}<span></span>{{/if}}
        </div>
        {{/each}}
      </div>
      {{#if canEdit}}
      <button type="button" data-action="addMod" class="fx-add-btn" style="margin-top:8px">+ Ajouter une stat</button>
      <small class="fx-hint" style="display:block;margin-top:6px">
        Un talent se joue en <b>petit bonus contre petit malus</b> : ±1 à ±3 sur une principale,
        <b>±1 ou ±2 au maximum</b> sur un toucher (1 point = 5 points de pourcentage de touche)
        et sur l'armure fixe (1 point vaut ~36 points de score d'armure).
        Attention au sens du toucher : <b>+1 rend le coup PLUS facile</b>, il est soustrait du seuil.
      </small>
      {{/if}}
    </div>

    {{!-- Deux familles de résistances, à ne pas confondre : celle-ci réduit
          les DÉGÂTS reçus d'un type, la suivante agit sur la durée et le
          tick des ÉTATS. Voir damage-types.js vs resistances.js. --}}
    <div class="card">
      <h2>Résistances aux dégâts (par type)</h2>
      {{#if canEdit}}
        <div class="rpg-resist-elem-grid">
          {{#each resistElemRows as |r|}}
          <div class="rpg-resist-elem-cell">
            <label title="Réduction des dégâts de type {{r.label}} tant que le talent est porté. Négatif = vulnérabilité.">{{r.label}}</label>
            <div class="rpg-resist-elem-input">
              <input type="number" name="system.resistancesElem.{{r.key}}" value="{{r.value}}" min="-100" max="100" step="5"/>
              <span>%</span>
            </div>
          </div>
          {{/each}}
        </div>
        <div style="font-size:11px;opacity:.7;margin-top:4px">
          <b>100 %</b> = immunité, valeur <b>négative</b> = vulnérabilité (dégâts augmentés).
          C'est là qu'un talent « Peau d'écailles » (+feu) ou « Sang vif » (−glace) se règle.
        </div>
      {{else}}
        {{#if resistElemActive.length}}
        <div class="rpg-resist-elem-read">
          {{#each resistElemActive as |r|}}
          <span class="rpg-resist-elem-chip {{#if r.isWeak}}is-weak{{else}}is-resist{{/if}}">{{r.text}}</span>
          {{/each}}
        </div>
        {{else}}
        <div style="font-size:11px;opacity:.7">Aucune résistance aux dégâts.</div>
        {{/if}}
      {{/if}}
    </div>

    {{#if canEdit}}
    <div class="card">
      <h2>Résistances aux états</h2>
      <div class="rpg-resistances">
        {{#each system.resistances as |r idx|}}
        <div class="resistance-row" data-idx="{{idx}}" style="display:flex;gap:6px;align-items:center;margin-bottom:4px;flex-wrap:wrap">
          <select name="system.resistances.{{idx}}.tag" style="flex:1.5">
            {{#each @root.EFFECT_TAGS as |label tag|}}
              <option value="{{tag}}" {{#if (eq r.tag tag)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          <select name="system.resistances.{{idx}}.effectKey" style="flex:1.5;font-size:11px"
            title="Vide = tous les effets du type choisi ci-contre. Sinon, un effet précis du catalogue.">
            <option value="">— Tous les effets de ce type —</option>
            {{#each @root.EFFECT_CATALOG as |group gLabel|}}
            <optgroup label="{{gLabel}}">
              {{#each group as |e|}}
              <option value="{{e.value}}" {{#if (eq r.effectKey e.value)}}selected{{/if}}>{{e.label}}</option>
              {{/each}}
            </optgroup>
            {{/each}}
          </select>
          <label style="font-size:11px;white-space:nowrap"
            title="Tours retirés à l'effet reçu. POSITIF = il dure moins longtemps (résistance) ; NÉGATIF = il dure plus longtemps (vulnérabilité).">Durée −<input type="number" name="system.resistances.{{idx}}.durationReduction" value="{{r.durationReduction}}" step="1" style="width:50px"/></label>
          <label style="font-size:11px;white-space:nowrap"
            title="Pourcentage retiré aux dégâts par tour de l'effet reçu. POSITIF = il fait moins mal ; NÉGATIF = il fait plus mal.">DOT −<input type="number" name="system.resistances.{{idx}}.dotReductionPct" value="{{r.dotReductionPct}}" min="-100" max="100" step="5" style="width:50px"/>%</label>
          <label style="font-size:11px;white-space:nowrap"><input type="checkbox" name="system.resistances.{{idx}}.immune" {{#if r.immune}}checked{{/if}}/> Immunité</label>
          <button type="button" data-action="removeResistance" data-idx="{{idx}}" title="Retirer">✕</button>
        </div>
        {{/each}}
      </div>
      <button type="button" data-action="addResistance" style="margin-top:4px">+ Ajouter une résistance</button>
      <div style="font-size:11px;opacity:.7;margin-top:4px">
        Agit sur la <b>durée</b> et les <b>dégâts par tour</b> des états reçus — pas sur les dégâts directs.
        Une valeur <b>négative</b> est une vulnérabilité : l'état dure plus longtemps ou fait plus mal.
      </div>
    </div>
    {{/if}}

    <div class="card">
      <h2>Description</h2>
      {{#if canEdit}}
      <textarea name="system.description" rows="5" placeholder="Ce que ce talent dit du personnage.">{{system.description}}</textarea>
      {{else}}
      <div style="white-space:pre-wrap">{{system.description}}</div>
      {{/if}}
    </div>

  </section>
</form>
