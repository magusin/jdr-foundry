<form class="rpg-sheet rpg-spell-sheet" autocomplete="off">
  <header class="sheet-header">
    <div style="display:flex;align-items:center;gap:10px">
      <img class="rpg-img-edit" src="{{item.img}}" data-field="img" title="Changer l'image"
        style="width:48px;height:48px;cursor:{{#if canEdit}}pointer{{else}}default{{/if}};border-radius:8px;border:1px solid var(--color-border-light-2)"/>
      {{#if canEdit}}
      <input name="name" type="text" value="{{item.name}}" placeholder="Nom du sort" style="flex:1;font-size:1.3em;font-weight:700"/>
      {{else}}
      <h2 style="flex:1;margin:0">{{item.name}}</h2>
      {{/if}}
      {{#if isGM}}<span style="font-size:10px;padding:2px 8px;border-radius:10px;background:rgba(180,120,0,0.2);color:#c8960a">MJ</span>{{/if}}
    </div>
    {{#if isGM}}
    <div style="display:flex;align-items:flex-start;justify-content:flex-end">
      <button type="button" data-action="sendToActors" style="cursor:pointer;padding:4px 10px;white-space:nowrap" title="Envoyer une copie à un ou plusieurs PJ">📤 Envoyer</button>
    </div>
    {{/if}}
  </header>

  <section class="sheet-body" style="display:flex;flex-direction:column;gap:10px;padding:10px">

    {{!-- ═══ INFOS GÉNÉRALES ═══ --}}
    {{#if canEdit}}
    <section class="card">
      <h2>Général</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">

        <div>
          <label>Vitesse</label>
          {{#if canEdit}}
          <select name="system.speed" style="width:100%">
            <option value="passif" {{#if (eq system.speed "passif")}}selected{{/if}}>Passif</option>
            <option value="rapide" {{#if (eq system.speed "rapide")}}selected{{/if}}>Rapide</option>
            <option value="normal" {{#if (eq system.speed "normal")}}selected{{/if}}>Normal</option>
          </select>
          {{else}}<div><b>{{system.speed}}</b></div>{{/if}}
        </div>

        <div>
          <label>Livraison</label>
          {{#if canEdit}}
          <select name="system.livraison" style="width:100%">
            <option value="magique"  {{#if (eq system.livraison "magique")}}selected{{/if}}>Magique</option>
            <option value="physique" {{#if (eq system.livraison "physique")}}selected{{/if}}>Physique</option>
          </select>
          {{else}}<div><b>{{system.livraison}}</b></div>{{/if}}
        </div>

        <div>
          <label>Élément / Type</label>
          {{#if canEdit}}
          <select name="system.tag" style="width:100%">
            <option value="neutre"    {{#if (eq system.tag "neutre")}}selected{{/if}}>⚪ Neutre</option>
            <option value="feu"       {{#if (eq system.tag "feu")}}selected{{/if}}>🔥 Feu</option>
            <option value="eau"       {{#if (eq system.tag "eau")}}selected{{/if}}>💧 Eau</option>
            <option value="eclair"    {{#if (eq system.tag "eclair")}}selected{{/if}}>⚡ Éclair</option>
            <option value="glace"     {{#if (eq system.tag "glace")}}selected{{/if}}>❄️ Glace</option>
            <option value="air"       {{#if (eq system.tag "air")}}selected{{/if}}>💨 Air</option>
            <option value="terre"     {{#if (eq system.tag "terre")}}selected{{/if}}>🌍 Terre</option>
            <option value="lumiere"   {{#if (eq system.tag "lumiere")}}selected{{/if}}>✨ Lumière</option>
            <option value="obscurite" {{#if (eq system.tag "obscurite")}}selected{{/if}}>🌑 Obscurité</option>
          </select>
          {{else}}
          <div style="font-size:13px">
            {{#if (eq system.tag "feu")}}🔥 Feu{{/if}}
            {{#if (eq system.tag "eau")}}💧 Eau{{/if}}
            {{#if (eq system.tag "eclair")}}⚡ Éclair{{/if}}
            {{#if (eq system.tag "glace")}}❄️ Glace{{/if}}
            {{#if (eq system.tag "air")}}💨 Air{{/if}}
            {{#if (eq system.tag "terre")}}🌍 Terre{{/if}}
            {{#if (eq system.tag "lumiere")}}✨ Lumière{{/if}}
            {{#if (eq system.tag "obscurite")}}🌑 Obscurité{{/if}}
            {{#if (eq system.tag "neutre")}}⚪ Neutre{{/if}}
            {{#unless system.tag}}⚪ Neutre{{/unless}}
          </div>
          {{/if}}
        </div>

        <div>
          <label>Coût Mana</label>
          {{#if canEdit}}<input type="number" name="system.coutMana" value="{{system.coutMana}}" min="0" style="width:100%"/>
          {{else}}<div><b>{{system.coutMana}}</b></div>{{/if}}
          {{#if weatherEffect}}
          <div style="margin-top:3px;padding:3px 6px;border-radius:4px;font-size:11px;font-weight:600;
            background:{{weatherEffect.color}}22;border:1px solid {{weatherEffect.color}}44;color:{{weatherEffect.color}}">
            {{weatherEffect.icon}} {{weatherEffect.label}} : {{weatherEffect.manaCoutEffectif}} mana
            ({{weatherEffect.mult}})
          </div>
          {{/if}}
        </div>

        <div>
          <label title="Fatigue consommée à chaque lancement de ce sort">Coût fatigue</label>
          {{#if canEdit}}<input type="number" name="system.fatigueCost" value="{{system.fatigueCost}}" min="0" style="width:100%"/>
          {{else}}<div><b>{{system.fatigueCost}}</b></div>{{/if}}
        </div>

        <div>
          <label>Portée min</label>
          {{#if canEdit}}<input type="number" name="system.range.min" value="{{system.range.min}}" min="0" step="0.1" style="width:100%"/>
          {{else}}<div><b>{{system.range.min}}</b></div>{{/if}}
        </div>

        <div>
          <label>Portée max</label>
          {{#if canEdit}}<input type="number" name="system.range.max" value="{{system.range.max}}" min="0" step="0.1" style="width:100%"/>
          {{else}}<div><b>{{system.range.max}}</b></div>{{/if}}
        </div>

        <div>
          <label title="Sur un ENNEMI : malus ajouté au seuil de touché, qui vient du rapport de stats (0 = pas de malus). Sur un ALLIÉ ou sur soi : aucune comparaison de stats, cette valeur EST le seuil à atteindre (ex. 11 = 11+), et 0 signifie réussite automatique.">Difficulté</label>
          {{#if canEdit}}<input type="number" name="system.difficulte" value="{{system.difficulte}}" min="0" style="width:100%"/>
          {{else}}<div><b>{{system.difficulte}}</b></div>{{/if}}
        </div>

        <div>
          <label>Cibles min</label>
          {{#if canEdit}}<input type="number" name="system.targetCount.min" value="{{system.targetCount.min}}" min="0" style="width:100%"/>
          {{else}}<div><b>{{system.targetCount.min}}</b></div>{{/if}}
        </div>

        <div>
          <label>Cibles max</label>
          {{#if canEdit}}<input type="number" name="system.targetCount.max" value="{{system.targetCount.max}}" min="0" style="width:100%"/>
          {{else}}<div><b>{{system.targetCount.max}}</b></div>{{/if}}
        </div>

        <div>
          <label>Recharge max</label>
          {{#if canEdit}}<input type="number" name="system.cooldown.max" value="{{system.cooldown.max}}" min="0" style="width:100%"/>
          {{else}}<div><b>{{system.cooldown.max}}</b></div>{{/if}}
        </div>

        <div>
          <label>Recharge restante</label>
          <input type="number" name="system.cooldown.restant" value="{{system.cooldown.restant}}" min="0" style="width:100%"/>
        </div>

      </div>
    </section>
    {{else}}
    {{!-- Vue joueur : uniquement ce qui est renseigné, jamais de case vide --}}
    <section class="card">
      <h2>{{item.name}}</h2>
      {{#if playerInfo.length}}
      <div class="spell-player-info">
        {{#each playerInfo as |row|}}
        <div class="spi-row{{#if row.wide}} spi-row--wide{{/if}}">
          <span class="spi-label">{{row.icon}} {{row.label}}</span>
          <b class="spi-value">{{row.value}}</b>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="fx-hint">Aucune caractéristique chiffrée — voir la description.</div>
      {{/if}}
    </section>
    {{/if}}

    {{!-- ═══ DÉGÂTS (multiples lignes) — MJ uniquement ═══
         Le joueur retrouve la formule dans le résumé du haut : lui montrer
         la grille de saisie revenait à le laisser modifier le sort.      --}}
    {{#if canEdit}}
    <section class="card">
      <div style="display:flex;align-items:center;justify-content:space-between">
        <h2>Dégâts</h2>
        {{#if canEdit}}
        <button type="button" data-action="addDmgLine" style="padding:2px 10px;cursor:pointer">+ Ligne</button>
        {{/if}}
      </div>

      {{#if system.damages.length}}
      <div style="display:grid;grid-template-columns:66px 42px 96px 40px 52px 60px 44px 52px 82px 24px;gap:4px;padding:0 4px 2px;font-size:10px;opacity:.65;font-weight:600">
        <span>Dés</span><span>Plat</span><span>Stat</span><span>Par</span><span>Gain/niv</span><span title="Dés de dégâts sur réussite critique">Crit dés</span><span title="Bonus plat de dégâts sur réussite critique (peut différer du plat normal)">Crit plat</span><span title="Part des dégâts réellement infligés rendue en PV au lanceur">Vol de vie</span><span>Livraison</span><span></span>
      </div>
      {{/if}}

      {{#each system.damages as |dmg i|}}
      <div class="dmg-row" data-idx="{{i}}"
        style="display:grid;grid-template-columns:66px 42px 96px 40px 52px 60px 44px 52px 82px 24px;gap:4px;align-items:center;margin-bottom:4px;padding:4px 4px;background:var(--surface);border-radius:6px">
        <input type="text"   name="system.damages.{{i}}.dice"     value="{{dmg.dice}}"     placeholder="1d6" style="font-size:12px" title="Dés normaux (ex: 1d6)"/>
        <input type="number" name="system.damages.{{i}}.flat"     value="{{dmg.flat}}"     placeholder="0"   style="font-size:12px" title="Bonus plat normal"/>
        <select              name="system.damages.{{i}}.stat"                                                 style="font-size:12px">
          <option value="intelligence" {{#if (eq dmg.stat "intelligence")}}selected{{/if}}>Intelligence</option>
          <option value="force"        {{#if (eq dmg.stat "force")}}selected{{/if}}>Force</option>
          <option value="dexterite"    {{#if (eq dmg.stat "dexterite")}}selected{{/if}}>Dextérité</option>
          <option value="acuite"       {{#if (eq dmg.stat "acuite")}}selected{{/if}}>Acuité</option>
          <option value="endurance"    {{#if (eq dmg.stat "endurance")}}selected{{/if}}>Endurance</option>
          <option value=""             {{#unless dmg.stat}}selected{{/unless}}>— aucune</option>
        </select>
        <input type="number" name="system.damages.{{i}}.per"      value="{{dmg.per}}"      placeholder="10"  style="font-size:12px" title="Stat / N (ex: 10 = +gain tous les 10 points)"/>
        <input type="number" name="system.damages.{{i}}.perStep"  value="{{dmg.perStep}}"  placeholder="1"   style="font-size:12px" title="Gain par palier de stat"/>
        <input type="text"   name="system.damages.{{i}}.critDice" value="{{dmg.critDice}}" placeholder="1d6" style="font-size:12px" title="Dés sur critique (vide = mêmes dés que normal)"/>
        <input type="number" name="system.damages.{{i}}.critFlat" value="{{dmg.critFlat}}" placeholder="0"   style="font-size:12px" title="Bonus plat sur critique (remplace le plat normal). Ex: normal 1d6+0, crit 1d6+2"/>
        <input type="number" name="system.damages.{{i}}.siphon"   value="{{dmg.siphon}}"   placeholder="0"   min="0" max="100" style="font-size:12px" title="Vol de vie : % des dégâts infligés rendus en PV au lanceur (0 = aucun)"/>
        <select              name="system.damages.{{i}}.livraison"                                            style="font-size:12px">
          <option value="magique"  {{#if (eq dmg.livraison "magique")}}selected{{/if}}>Magique</option>
          <option value="physique" {{#if (eq dmg.livraison "physique")}}selected{{/if}}>Physique</option>
        </select>
        {{#if @root.canEdit}}
        <button type="button" data-action="removeDmgLine" data-idx="{{i}}"
          style="cursor:pointer;color:#c0392b;border:none;background:none;font-size:14px;padding:0">✕</button>
        {{else}}<span></span>{{/if}}
      </div>
      {{/each}}

      {{#unless system.damages.length}}
      <div style="font-size:11px;opacity:.6;padding:4px">Aucune ligne — clique "+ Ligne" pour en ajouter.</div>
      {{/unless}}
    </section>
    {{/if}}

    {{!-- ═══ RÉCUPÉRATION (soin PV / mana / fatigue) ═══
         Symétrique de « Dégâts » : un sort peut rendre au lieu de retirer.
         Ex. Repos : Fatigue, 1d10 + 5 + Endurance/10, sur soi.            --}}
    {{#if showRestores}}
    <section class="card">
      <div style="display:flex;align-items:center;justify-content:space-between">
        <h2>Récupération</h2>
        {{#if canEdit}}
        <button type="button" data-action="addRestoreLine" style="padding:2px 10px;cursor:pointer">+ Ligne</button>
        {{/if}}
      </div>

      {{#if system.restores.length}}
      <div style="display:grid;grid-template-columns:78px 70px 66px 42px 96px 40px 52px 60px 44px 24px;gap:4px;padding:0 4px 2px;font-size:10px;opacity:.65;font-weight:600">
        <span>Ressource</span><span>Bénéficiaire</span><span>Dés</span><span>Plat</span><span>Stat</span><span>Par</span><span>Gain/niv</span><span title="Dés sur réussite critique">Crit dés</span><span title="Bonus plat sur réussite critique">Crit plat</span><span></span>
      </div>
      {{/if}}

      {{#each system.restores as |res i|}}
      <div class="restore-row" data-idx="{{i}}"
        style="display:grid;grid-template-columns:78px 70px 66px 42px 96px 40px 52px 60px 44px 24px;gap:4px;align-items:center;margin-bottom:4px;padding:4px 4px;background:var(--surface);border-radius:6px">
        <select              name="system.restores.{{i}}.resource" style="font-size:12px" title="Ce que le sort rend">
          <option value="pv"      {{#if (eq res.resource "pv")}}selected{{/if}}>❤️ PV</option>
          <option value="mana"    {{#if (eq res.resource "mana")}}selected{{/if}}>🔷 Mana</option>
          <option value="fatigue" {{#if (eq res.resource "fatigue")}}selected{{/if}}>😴 Fatigue</option>
        </select>
        <select              name="system.restores.{{i}}.cible" style="font-size:12px" title="Qui en profite">
          <option value="self"   {{#if (eq res.cible "self")}}selected{{/if}}>Soi</option>
          <option value="target" {{#if (eq res.cible "target")}}selected{{/if}}>Cible(s)</option>
        </select>
        <input type="text"   name="system.restores.{{i}}.dice"     value="{{res.dice}}"     placeholder="1d10" style="font-size:12px" title="Dés (ex: 1d10)"/>
        <input type="number" name="system.restores.{{i}}.flat"     value="{{res.flat}}"     placeholder="0"    style="font-size:12px" title="Bonus plat"/>
        <select              name="system.restores.{{i}}.stat"                                                  style="font-size:12px">
          <option value="endurance"    {{#if (eq res.stat "endurance")}}selected{{/if}}>Endurance</option>
          <option value="intelligence" {{#if (eq res.stat "intelligence")}}selected{{/if}}>Intelligence</option>
          <option value="force"        {{#if (eq res.stat "force")}}selected{{/if}}>Force</option>
          <option value="dexterite"    {{#if (eq res.stat "dexterite")}}selected{{/if}}>Dextérité</option>
          <option value="acuite"       {{#if (eq res.stat "acuite")}}selected{{/if}}>Acuité</option>
          <option value=""             {{#unless res.stat}}selected{{/unless}}>— aucune</option>
        </select>
        <input type="number" name="system.restores.{{i}}.per"      value="{{res.per}}"      placeholder="10" style="font-size:12px" title="Stat / N (ex: 10 = +gain tous les 10 points)"/>
        <input type="number" name="system.restores.{{i}}.perStep"  value="{{res.perStep}}"  placeholder="1"  style="font-size:12px" title="Gain par palier de stat"/>
        <input type="text"   name="system.restores.{{i}}.critDice" value="{{res.critDice}}" placeholder=""   style="font-size:12px" title="Dés sur critique (vide = mêmes dés que normal)"/>
        <input type="number" name="system.restores.{{i}}.critFlat" value="{{res.critFlat}}" placeholder="0"  style="font-size:12px" title="Bonus plat sur critique (remplace le plat normal)"/>
        {{#if @root.canEdit}}
        <button type="button" data-action="removeRestoreLine" data-idx="{{i}}"
          style="cursor:pointer;color:#c0392b;border:none;background:none;font-size:14px;padding:0">✕</button>
        {{else}}<span></span>{{/if}}
      </div>
      {{/each}}

      {{#unless system.restores.length}}
      <div style="font-size:11px;opacity:.6;padding:4px">
        Aucune ligne — clique "+ Ligne" pour un sort qui rend des PV, du mana ou de la fatigue.
      </div>
      {{/unless}}
    </section>
    {{/if}}

    {{!-- ═══ EFFETS ═══ --}}
    {{#if showEffects}}
    <section class="card">
      <div style="display:flex;align-items:center;justify-content:space-between">
        <h2>Effets secondaires</h2>
        {{#if canEdit}}
        <button type="button" data-action="addEffect" style="padding:2px 10px;cursor:pointer">+ Effet</button>
        {{/if}}
      </div>

      {{#each system.effectsUI as |fx i|}}
      <details class="fx-card" data-fx-index="{{i}}" {{#unless @root.canEdit}}open{{/unless}}>
        <summary class="fx-summary">
          <span class="fx-title">{{#if fx.label}}{{fx.label}}{{else}}Effet {{i}}{{/if}}</span>
          <span class="fx-chips">
            <span class="fx-chip fx-chip-when">{{fx.uiWhen}}</span>
            <span class="fx-chip">{{fx.uiDuration}}</span>
            {{#if fx.tag}}<span class="fx-chip fx-chip-tag">{{fx.tag}}</span>{{/if}}
            {{#if fx.uiTick}}<span class="fx-chip fx-chip-tick">{{fx.uiTick}}</span>{{/if}}
            {{#each fx.mods as |mod mi|}}
            <span class="fx-chip {{#if mod.isMalus}}fx-chip-malus{{else}}fx-chip-bonus{{/if}}">{{mod.text}}</span>
            {{/each}}
            {{#if fx.uiAura}}<span class="fx-chip fx-chip-aura">{{fx.uiAura}}</span>{{/if}}
            {{#if fx.uiMove}}<span class="fx-chip">{{fx.uiMove}}</span>{{/if}}
            {{#if fx.uiRemove}}<span class="fx-chip">{{fx.uiRemove}}</span>{{/if}}
          </span>
          {{#if @root.canEdit}}
          <button type="button" data-action="removeEffect" data-fx-index="{{i}}"
            class="fx-del-btn" title="Supprimer cet effet">✕</button>
          {{/if}}
        </summary>

        {{#if @root.canEdit}}
        {{!-- ════════ FORMULAIRE MJ ════════ --}}
        <div class="fx-body">

          {{!-- 1 · Identité --}}
          <fieldset class="fx-fieldset">
            <legend>1 · Identité</legend>
            <div class="fx-grid-2">
              <div>
                <label title="Choisir un effet du catalogue remplit automatiquement le nom et le type.">Effet du catalogue</label>
                <select class="fx-catalogue-select" data-fx-idx="{{i}}" data-fx-field="effectKey">
                  <option value="">— Nom libre —</option>
                  {{#each @root.EFFECT_CATALOG as |group gLabel|}}
                  <optgroup label="{{gLabel}}">
                    {{#each group as |e|}}
                    <option value="{{e.key}}" data-tag="{{e.tag}}" data-label="{{e.label}}"
                      {{#if (eq fx.effectKey e.key)}}selected{{/if}}>{{e.label}}</option>
                    {{/each}}
                  </optgroup>
                  {{/each}}
                </select>
              </div>
              <div>
                <label>Nom affiché</label>
                <input type="text" data-fx-field="label" value="{{fx.label}}" placeholder="Nom de l'effet"/>
              </div>
              <div>
                <label>Type / Élément</label>
                <select data-fx-field="tag">
                  <option value="" {{#unless fx.tag}}selected{{/unless}}>— Aucun —</option>
                  <option value="magique"  {{#if (eq fx.tag "magique")}}selected{{/if}}>✨ Magique</option>
                  <option value="physique" {{#if (eq fx.tag "physique")}}selected{{/if}}>⚔️ Physique</option>
                  <option value="feu"    {{#if (eq fx.tag "feu")}}selected{{/if}}>🔥 Feu</option>
                  <option value="air"    {{#if (eq fx.tag "air")}}selected{{/if}}>🌬️ Air</option>
                  <option value="eau"    {{#if (eq fx.tag "eau")}}selected{{/if}}>💧 Eau</option>
                  <option value="glace"  {{#if (eq fx.tag "glace")}}selected{{/if}}>❄️ Glace</option>
                  <option value="eclair" {{#if (eq fx.tag "eclair")}}selected{{/if}}>⚡ Éclair</option>
                  <option value="terre"  {{#if (eq fx.tag "terre")}}selected{{/if}}>🌿 Terre</option>
                  <option value="lumiere"  {{#if (eq fx.tag "lumiere")}}selected{{/if}}>✨ Lumière</option>
                  <option value="obscurite" {{#if (eq fx.tag "obscurite")}}selected{{/if}}>🌑 Obscurité</option>
                </select>
              </div>
            </div>
          </fieldset>

          {{!-- 2 · Quand et combien de temps --}}
          <fieldset class="fx-fieldset">
            <legend>2 · Déclenchement &amp; durée</legend>
            <div class="fx-grid-4">
              <div>
                <label title="Sur toute touche réussie (critique compris), sur une touche normale seulement (pas sur un critique), uniquement sur un critique, ou dès le lancement quel que soit le résultat.">⚡ Se déclenche</label>
                <select data-fx-field="when">
                  <option value="hit"     {{#if (eq fx.when "hit")}}selected{{/if}}>Touche normale + crit</option>
                  <option value="hitOnly" {{#if (eq fx.when "hitOnly")}}selected{{/if}}>Touche normale uniquement</option>
                  <option value="crit"    {{#if (eq fx.when "crit")}}selected{{/if}}>Critique uniquement</option>
                  <option value="cast"    {{#if (eq fx.when "cast")}}selected{{/if}}>Au lancement (toujours)</option>
                </select>
              </div>
              <div>
                <label>⏳ Durée (tours)</label>
                <input type="number" data-fx-field="duration" value="{{fx.duration}}" min="0"/>
              </div>
              <div>
                <label>♾️ Permanent</label>
                <label class="fx-check" title="L'effet ne disparaît jamais tout seul ; la durée est ignorée.">
                  <input type="checkbox" data-fx-field="permanent" {{#if fx.permanent}}checked{{/if}} />
                  <span>N'expire pas</span>
                </label>
              </div>
              <div>
                <label title="Difficulté du jet que la cible doit réussir pour se débarrasser de l'effet (macro « Retirer un État »). 0 = l'effet ne peut pas être retiré par un jet.">🧹 TN de retrait</label>
                <input type="number" data-fx-field="removeBaseTN" value="{{fx.removeBaseTN}}" min="0" max="20" placeholder="0" title="0 = impossible à retirer par un jet"/>
              </div>
              <div>
                <label title="Modificateur ajouté au TN de retrait : positif = plus difficile à dissiper, négatif = plus facile. S'ajoute aux modificateurs d'équipement et d'états.">↕️ Modif. de retrait</label>
                <input type="number" data-fx-field="retraitMod" value="{{fx.retraitMod}}" placeholder="0" title="+ = plus dur à retirer, − = plus facile"/>
              </div>
            </div>
          </fieldset>

          {{!-- 3 · Effet par tour --}}
          <fieldset class="fx-fieldset">
            <legend>3 · Effet par tour</legend>
            <div class="fx-grid-5">
              <div>
                <label title="Cet effet inflige des dégâts, rend des PV, ou ne fait ni l'un ni l'autre.">Nature</label>
                <select data-fx-field="tick.mode">
                  <option value="none"   {{#if (eq fx.tick.mode "none")}}selected{{/if}}>— Aucun —</option>
                  <option value="damage" {{#if (eq fx.tick.mode "damage")}}selected{{/if}}>💥 Dégâts</option>
                  <option value="heal"   {{#if (eq fx.tick.mode "heal")}}selected{{/if}}>💚 Soin</option>
                </select>
              </div>
              <div data-fx-when="tick">
                <label title="Part fixe appliquée à chaque tour. Toujours positive.">Fixe</label>
                <input type="number" data-fx-field="tick.flat" value="{{fx.tick.flat}}" min="0" placeholder="0"/>
              </div>
              <div data-fx-when="tick">
                <label title="Stat du lanceur qui renforce l'effet (ex : Intelligence ÷ 10).">Stat</label>
                <select data-fx-field="tick.stat">
                  <option value="" {{#unless fx.tick.stat}}selected{{/unless}}>— aucune —</option>
                  <option value="intelligence" {{#if (eq fx.tick.stat "intelligence")}}selected{{/if}}>Intelligence</option>
                  <option value="force"        {{#if (eq fx.tick.stat "force")}}selected{{/if}}>Force</option>
                  <option value="dexterite"    {{#if (eq fx.tick.stat "dexterite")}}selected{{/if}}>Dextérité</option>
                  <option value="acuite"       {{#if (eq fx.tick.stat "acuite")}}selected{{/if}}>Acuité</option>
                  <option value="endurance"    {{#if (eq fx.tick.stat "endurance")}}selected{{/if}}>Endurance</option>
                </select>
              </div>
              <div data-fx-when="tick">
                <label title="Diviseur : 10 = un palier tous les 10 points de stat.">÷ Par</label>
                <input type="number" data-fx-field="tick.per" value="{{fx.tick.per}}" min="1" placeholder="10"/>
              </div>
              <div data-fx-when="tick">
                <label title="Points gagnés à chaque palier de stat.">× Gain</label>
                <input type="number" data-fx-field="tick.perStep" value="{{fx.tick.perStep}}" min="0" placeholder="1"/>
              </div>
              <div data-fx-when="tick">
                <label title="Type de dégâts (ignoré pour un soin).">Livraison</label>
                <select data-fx-field="tick.livraison">
                  <option value="magique"  {{#if (eq fx.tick.livraison "magique")}}selected{{/if}}>Magique</option>
                  <option value="physique" {{#if (eq fx.tick.livraison "physique")}}selected{{/if}}>Physique</option>
                </select>
              </div>
            </div>
            <small class="fx-hint">Laisse sur <b>Aucun</b> si l'effet n'inflige ni dégâts ni soin. Sinon : <b>Fixe + (stat ÷ Par) × Gain</b> par tour.</small>
          </fieldset>

          {{!-- 4 · Bonus / Malus --}}
          <fieldset class="fx-fieldset">
            <legend>4 · Bonus / Malus de stats</legend>
            <div class="fx-mods-list" data-fx-idx="{{i}}">
              {{#if fx.mods.length}}
              <div class="fx-mod-row fx-mod-head">
                <span>Stat</span><span>Sens</span><span>Type</span><span>Valeur</span><span></span>
              </div>
              {{/if}}
              {{#each fx.mods as |mod mi|}}
              <div class="fx-mod-row" data-mod-index="{{mi}}">
                <select data-mod-field="stat">
                  <optgroup label="Caractéristiques">
                    <option value="force"        {{#if (eq mod.stat "force")}}selected{{/if}}>Force</option>
                    <option value="dexterite"    {{#if (eq mod.stat "dexterite")}}selected{{/if}}>Dextérité</option>
                    <option value="intelligence" {{#if (eq mod.stat "intelligence")}}selected{{/if}}>Intelligence</option>
                    <option value="acuite"       {{#if (eq mod.stat "acuite")}}selected{{/if}}>Acuité</option>
                    <option value="endurance"    {{#if (eq mod.stat "endurance")}}selected{{/if}}>Endurance</option>
                  </optgroup>
                  <optgroup label="Défenses">
                    <option value="armureFixe"      {{#if (eq mod.stat "armureFixe")}}selected{{/if}}>Armure fixe</option>
                    <option value="resistanceFixe"  {{#if (eq mod.stat "resistanceFixe")}}selected{{/if}}>Résistance fixe</option>
                    <option value="scoreArmure"     {{#if (eq mod.stat "scoreArmure")}}selected{{/if}}>Score Armure</option>
                    <option value="scoreResistance" {{#if (eq mod.stat "scoreResistance")}}selected{{/if}}>Score Résistance</option>
                  </optgroup>
                  <optgroup label="Combat">
                    <option value="toucherPhysique" {{#if (eq mod.stat "toucherPhysique")}}selected{{/if}}>Toucher physique</option>
                    <option value="toucherMagique"  {{#if (eq mod.stat "toucherMagique")}}selected{{/if}}>Toucher magique</option>
                    <option value="initiativeMod"   {{#if (eq mod.stat "initiativeMod")}}selected{{/if}}>Initiative</option>
                    <option value="vitesse"         {{#if (eq mod.stat "vitesse")}}selected{{/if}}>Vitesse</option>
                  </optgroup>
                  <optgroup label="Ressources">
                    <option value="pvMax"      {{#if (eq mod.stat "pvMax")}}selected{{/if}}>PV max</option>
                    <option value="manaMax"    {{#if (eq mod.stat "manaMax")}}selected{{/if}}>Mana max</option>
                    <option value="regenPv"    {{#if (eq mod.stat "regenPv")}}selected{{/if}}>Régén PV</option>
                    <option value="regenMana"  {{#if (eq mod.stat "regenMana")}}selected{{/if}}>Régén Mana</option>
                    <option value="fatigueMax" {{#if (eq mod.stat "fatigueMax")}}selected{{/if}}>Fatigue max</option>
                    <option value="podsMax"    {{#if (eq mod.stat "podsMax")}}selected{{/if}}>Pods max</option>
                  </optgroup>
                </select>
                <select data-mod-field="sens">
                  <option value="bonus" {{#unless mod.isMalus}}selected{{/unless}}>⬆️ Bonus</option>
                  <option value="malus" {{#if mod.isMalus}}selected{{/if}}>⬇️ Malus</option>
                </select>
                <select data-mod-field="mode">
                  <option value="flat" {{#if (eq mod.mode "flat")}}selected{{/if}}>Fixe</option>
                  <option value="pct"  {{#if (eq mod.mode "pct")}}selected{{/if}}>%</option>
                </select>
                <input type="number" data-mod-field="value" value="{{mod.absValue}}" min="0" placeholder="0"
                  title="Quantité, toujours positive — le sens est choisi à gauche."/>
                <button type="button" data-action="removeMod" data-fx-idx="{{i}}" data-mod-index="{{mi}}"
                  class="fx-del-btn" title="Retirer cette stat">✕</button>
              </div>
              {{/each}}
            </div>
            <button type="button" data-action="addMod" data-fx-idx="{{i}}" class="fx-add-btn">+ Ajouter une stat</button>
            <small class="fx-hint">Facultatif — laisse vide si l'effet ne change aucune stat. Ex. Enlisement : <b>Vitesse · Malus · % · 25</b>. La <b>Fatigue max</b> se gère ici aussi.</small>
          </fieldset>

          {{!-- 5 · Aura & déplacement --}}
          <fieldset class="fx-fieldset">
            <legend>5 · Aura &amp; déplacement</legend>
            <div class="fx-grid-4">
              <div>
                <label>🌀 Aura</label>
                <label class="fx-check" title="L'effet rayonne autour du porteur et touche les tokens dans la zone.">
                  <input type="checkbox" data-fx-field="isAura" {{#if fx.isAura}}checked{{/if}} />
                  <span>Activer</span>
                </label>
              </div>
              <div data-fx-when="aura">
                <label>Portée (m)</label>
                <div class="fx-inline-2">
                  <input type="number" data-fx-field="auraMin" value="{{fx.auraMin}}" min="0" step="0.1" title="Portée minimale"/>
                  <input type="number" data-fx-field="auraMax" value="{{fx.auraMax}}" min="0" step="0.1" title="Portée maximale"/>
                </div>
              </div>
              <div data-fx-when="aura">
                <label>Cible de l'aura</label>
                <select data-fx-field="auraTarget">
                  <option value="allies"  {{#if (eq fx.auraTarget "allies")}}selected{{/if}}>🟢 Alliés</option>
                  <option value="enemies" {{#if (eq fx.auraTarget "enemies")}}selected{{/if}}>🔴 Ennemis</option>
                  <option value="both"    {{#if (eq fx.auraTarget "both")}}selected{{/if}}>⚪ Tout le monde</option>
                </select>
              </div>
              <div>
                <label>🏃 Mode déplacement accordé</label>
                <select data-fx-field="movementTypeGrant">
                  <option value="" {{#unless fx.movementTypeGrant}}selected{{/unless}}>— Aucun —</option>
                  <option value="volant"     {{#if (eq fx.movementTypeGrant "volant")}}selected{{/if}}>🦅 Vol</option>
                  <option value="aquatique"  {{#if (eq fx.movementTypeGrant "aquatique")}}selected{{/if}}>🐟 Nage</option>
                  <option value="amphibie"   {{#if (eq fx.movementTypeGrant "amphibie")}}selected{{/if}}>🐸 Amphibie</option>
                  <option value="ethere"     {{#if (eq fx.movementTypeGrant "ethere")}}selected{{/if}}>👻 Éthéré</option>
                  <option value="montagnard" {{#if (eq fx.movementTypeGrant "montagnard")}}selected{{/if}}>⛰️ Montagnard</option>
                  <option value="forestier"  {{#if (eq fx.movementTypeGrant "forestier")}}selected{{/if}}>🌲 Forestier</option>
                </select>
              </div>
            </div>
            <small class="fx-hint">Facultatif — coche <b>Aura</b> seulement si l'effet doit rayonner autour de la cible.</small>
          </fieldset>

        </div>
        {{else}}
        {{!-- ════════ VUE JOUEUR — lecture seule, sans formulaire ════════ --}}
        <div class="fx-body fx-readonly">
          {{#if fx.uiHasSummary}}
          <ul class="fx-read-list">
            {{#if fx.uiTick}}<li>{{fx.uiTick}}</li>{{/if}}
            {{#each fx.mods as |mod mi|}}<li>{{mod.text}}</li>{{/each}}
            {{#if fx.uiAura}}<li>{{fx.uiAura}}</li>{{/if}}
            {{#if fx.uiMove}}<li>{{fx.uiMove}}</li>{{/if}}
            {{#if fx.uiRemove}}<li>{{fx.uiRemove}}</li>{{/if}}
          </ul>
          {{else}}
          <div class="fx-hint">Aucun effet chiffré — voir la description du sort.</div>
          {{/if}}
        </div>
        {{/if}}
      </details>
      {{/each}}
    </section>
    {{/if}}

    {{!-- ═══ DESCRIPTION ═══ --}}
    {{#if showDescription}}
    <section class="card">
      <h2>Description</h2>
      {{#if canEdit}}
      <textarea name="system.description" rows="4" style="width:100%">{{system.description}}</textarea>
      {{else}}
      {{!-- La description est stockée en HTML : l'échapper affichait les
           balises telles quelles au joueur (« <p>Le personnage… »).      --}}
      <div class="spell-description">{{{system.description}}}</div>
      {{/if}}
    </section>
    {{/if}}

  </section>
</form>
